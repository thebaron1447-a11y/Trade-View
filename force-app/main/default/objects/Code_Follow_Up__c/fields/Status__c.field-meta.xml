<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Status__c</fullName>
    <description>Lifecycle of the follow-up. Moving to Resolved re-matches all held rows; Closed - No Action sends them to manual review instead. A resolved follow-up is reopened if new rows are held for the same reason.</description>
    <inlineHelpText>Set to In Progress while you chase the information, and Resolved once the code is set up.</inlineHelpText>
    <label>Status</label>
    <required>true</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Open</fullName>
                <default>true</default>
                <label>Open</label>
            </value>
            <value>
                <fullName>In Progress</fullName>
                <default>false</default>
                <label>In Progress</label>
            </value>
            <value>
                <fullName>Resolved</fullName>
                <default>false</default>
                <label>Resolved</label>
            </value>
            <value>
                <fullName>Closed - No Action</fullName>
                <default>false</default>
                <label>Closed - No Action</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
