<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>End_Date_Source__c</fullName>
    <description>How the Effective End Date was established. Lets auditors distinguish dates the system inferred from dates verified externally.</description>
    <inlineHelpText>Select how the end date was confirmed. Choose Inferred from Review if it was set from trade data alone.</inlineHelpText>
    <label>End Date Source</label>
    <required>false</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Inferred from Review</fullName>
                <default>false</default>
                <label>Inferred from Review</label>
            </value>
            <value>
                <fullName>Confirmed by Firm</fullName>
                <default>false</default>
                <label>Confirmed by Firm</label>
            </value>
            <value>
                <fullName>Confirmed via Registration Search</fullName>
                <default>false</default>
                <label>Confirmed via Registration Search</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
