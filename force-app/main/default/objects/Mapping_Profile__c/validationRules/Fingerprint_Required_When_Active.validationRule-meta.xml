<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Fingerprint_Required_When_Active</fullName>
    <active>true</active>
    <description>Without a fingerprint the profile can never be selected.</description>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, "Active"), ISBLANK(Header_Fingerprint__c))</errorConditionFormula>
    <errorDisplayField>Header_Fingerprint__c</errorDisplayField>
    <errorMessage>An Active mapping profile needs a Header Fingerprint.</errorMessage>
</ValidationRule>
