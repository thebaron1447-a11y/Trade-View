<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Date_Format__c</fullName>
    <description>Date format used by this source. Declared once per profile because dates like 03/04/2026 are ambiguous row by row. A value that does not fit the format is flagged, not guessed.</description>
    <inlineHelpText>The date format this firm uses in its files.</inlineHelpText>
    <label>Date Format</label>
    <required>true</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>MM/DD/YYYY</fullName>
                <default>false</default>
                <label>MM/DD/YYYY</label>
            </value>
            <value>
                <fullName>DD/MM/YYYY</fullName>
                <default>false</default>
                <label>DD/MM/YYYY</label>
            </value>
            <value>
                <fullName>YYYY-MM-DD</fullName>
                <default>false</default>
                <label>YYYY-MM-DD</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
