<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Status__c</fullName>
    <description>Lifecycle stage of an import batch. Received is set by the inbound endpoint. Mapping Review means no active mapping profile matched the file's headers, or the matching profile is incomplete. Staged means every row was normalized into staging rows and the batch is ready for matching. Later values are used from phase 3. Set by Apex only.</description>
    <inlineHelpText>Shows where this import is in the process. Mapping Review and Pending Review batches are waiting on a reviewer.</inlineHelpText>
    <label>Status</label>
    <required>false</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Received</fullName>
                <default>false</default>
                <label>Received</label>
            </value>
            <value>
                <fullName>Mapping Review</fullName>
                <default>false</default>
                <label>Mapping Review</label>
            </value>
            <value>
                <fullName>Processing</fullName>
                <default>false</default>
                <label>Processing</label>
            </value>
            <value>
                <fullName>Staged</fullName>
                <default>false</default>
                <label>Staged</label>
            </value>
            <value>
                <fullName>Pending Review</fullName>
                <default>false</default>
                <label>Pending Review</label>
            </value>
            <value>
                <fullName>Approved</fullName>
                <default>false</default>
                <label>Approved</label>
            </value>
            <value>
                <fullName>Loading</fullName>
                <default>false</default>
                <label>Loading</label>
            </value>
            <value>
                <fullName>Completed</fullName>
                <default>false</default>
                <label>Completed</label>
            </value>
            <value>
